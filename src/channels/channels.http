# @name login
POST {{url}}/auth/signin
Content-Type: application/json

{
  "email": "douglasdev.cn@gmail.com",
  "password": 1234
}
###

@authToken = {{login.response.body.$.access_token}}

@endpoint = /channels

#### 1) Get all channels
GET {{url}}{{endpoint}}
Authorization: Bearer {{authToken}}

#### 2) Get a channel by id
GET {{url}}{{endpoint}}/1
Authorization: Bearer {{authToken}}

#### 3) Start a session
GET {{url}}{{endpoint}}/1/start
Authorization: Bearer {{authToken}}

#### 4) Create a new channel
POST {{url}}{{endpoint}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Suporte"
}