# @name login
POST {{url}}/auth/signin
Content-Type: application/json

{
  "email": "douglasdev.cn@gmail.com",
  "password": 1234
}
###

@authToken = {{login.response.body.$.access_token}}

@endpoint = /support-chats

#### 1) Get all support chats
GET {{url}}{{endpoint}}
Authorization: Bearer {{authToken}}

#### 2) Send a message
POST {{url}}{{endpoint}}/send-message
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "to": "user@example.com",
  "message": "Hello, this is a test message."
}

#### 3) Get support chat by ID
GET {{url}}{{endpoint}}/1/messages
Authorization: Bearer {{authToken}}
#### 4) Assinar upload de mídia
# Devolve a URL e os campos do POST assinado. O front envia o arquivo direto
# para o storage e guarda a `key` para o passo seguinte.
POST {{url}}{{endpoint}}/sign-media-post
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "key": "support-chats/1/video-teste",
  "fileType": "video/mp4"
}

#### 5) Enviar mídia (vídeo)
# O backend monta a URL pública a partir da `media_key` e a repassa ao provider,
# que baixa o arquivo direto - é o que permite vídeos grandes.
POST {{url}}{{endpoint}}/1/send-media
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "chat_id": "554199999999@s.whatsapp.net",
  "media_key": "support-chats/1/video-teste.mp4",
  "media_type": "video",
  "mimetype": "video/mp4",
  "caption": "Vídeo de teste"
}

#### 6) Enviar documento (fileName é obrigatório na prática)
POST {{url}}{{endpoint}}/1/send-media
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "chat_id": "554199999999@s.whatsapp.net",
  "media_key": "support-chats/1/orcamento.pdf",
  "media_type": "document",
  "mimetype": "application/pdf",
  "file_name": "orcamento.pdf"
}

###############################################################################
# Transferência de atendimento
#
# Só o dono transfere, e só um atendimento em andamento. Exige a permissão
# `support.chat:transfer` (id 50), que é própria - não basta `support.chat:update`.
###############################################################################

#### 7) Transferir para outro atendente
POST {{url}}{{endpoint}}/18/transferir
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "user_destino_id": 14,
  "motivo": "Cliente pediu para falar com o financeiro"
}

#### 8) Devolver para a espera (sem destinatário)
# Omitir `user_destino_id` não é erro: é o segundo caminho da mesma ação. A
# conversa perde o dono e volta para "Aguardando".
POST {{url}}{{endpoint}}/18/transferir
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "motivo": "Saindo do turno"
}
