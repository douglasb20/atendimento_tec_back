# Porta em que a API escuta. Existe também `APP_ENV`, que apesar do nome
# guarda a porta - mantida por compatibilidade; `PORT` tem precedência.
PORT=3001

# URL pública deste backend. Usada apenas como fallback de EVOLUTION_WEBHOOK_URL,
# quando esta não está preenchida.
APP_SERVER=

# ── Evolution API (gateway WhatsApp não-oficial) ────────────────────────────
# Único gateway suportado hoje; nunca coexistem duas instâncias ao mesmo
# tempo. Trocar de gateway no futuro substitui este bloco por variáveis
# próprias do novo provider.
EVOLUTION_BASE_URL=
# Chave global da Evolution (header `apikey`). Operações sobre uma instância
# específica usam o token próprio dela (channels.instance_token, emitido no
# /instance/create), não esta chave.
EVOLUTION_API_KEY=
# Opcional: sem ela, cai em `${APP_SERVER}/api/whatsapp/webhook`.
EVOLUTION_WEBHOOK_URL=
# Enviado no header x-webhook-secret e validado em todo webhook recebido.
EVOLUTION_WEBHOOK_SECRET=

# Origens aceitas pelo CORS da API e pelo WebSocket, separadas por vírgula.
# Vazio equivale a `http://localhost:3000` - o padrão de desenvolvimento.
CORS_ORIGINS=

DB_HOST=localhost
DB_USER=user
DB_PORT=3306
DB_PASS=pass
DB_NAME=dbname

MAIL_HOST=
# Lida pelo código e ausente deste arquivo até agora.
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Endereço público do portal, usado para montar o link de redefinição de senha
# enviado por e-mail. Sem ela o link sai apontando para localhost - o que em
# produção manda o usuário para a própria máquina dele.
# Ex.: URL_FRONTEND=https://suporte.automatecsistemasweb.com.br
URL_FRONTEND=

# Validade do link de redefinição, em minutos. Vazio equivale a 30.
RESET_SENHA_EXPIRACAO_MIN=
CRYPTO_IV= # 32 characters
CRYPTO_KEY= # 64 characters

ACCESS_JWT_SECRET=

REFRESH_JWT_SECRET=
# Validade do access token - curto: não é revogável.
ACCESS_JWT_EXPIRATION=30min
# Domínio dos cookies de sessão. Em produção, o domínio-pai comum ao front
# e à API (ex.: .automatecsistemasweb.com.br). Vazio em desenvolvimento.
COOKIE_DOMAIN=
# Validade do refresh token - longo: rotativo e revogável pelo banco.
REFRESH_JWT_EXPIRATION=30d

# ── Redis ───────────────────────────────────────────────────────────────────
# Campos separados, não URL: o código lê host/porta/credenciais individualmente.
# ⚠️ O Coolify oferece uma REDIS_URL pronta ao criar o recurso - ela NÃO é lida
# por este backend. Extraia dela os campos abaixo.
#   redis://default:<senha>@<host>:6379/0
#                   └senha┘ └host┘
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Bancos (slots) do Redis, numerados de 0 a 15. Separados de propósito: um
# flush no cache não pode levar junto os jobs de mensagem ainda na fila.
REDIS_DB_FILAS=0
REDIS_DB_CACHE=1

# Isolamento entre ambientes que dividem o mesmo Redis. Os nomes das filas são
# fixos no código (`whatsapp-messages-queue`), então sem prefixo prod e
# homologação escutam a mesma chave e um worker pode consumir o job do outro.
# Ex.: REDIS_PREFIX=hom - vazio em produção.
REDIS_PREFIX=
